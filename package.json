{
  "name": "automation-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "node scripts/licenses.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/playwright.mjs test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "browser:install": "node scripts/playwright.mjs install chromium firefox",
    "app:build": "node scripts/build-native.mjs",
    "app:open": "node scripts/open-native.mjs",
    "service:stop": "node scripts/service-control.mjs stop"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "vite": "8.3.8"
  },
  "license": "MIT"
}
